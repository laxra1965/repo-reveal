# Supabase Configuration
# Get these values from your Supabase project settings (Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: for development with local Supabase
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Security Configuration
# Generate a secure random key: openssl rand -hex 32
VITE_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# Admin Settings (for payment processing)
ADMIN_USDT_ADDRESS=your-usdt-trc20-address-here

# Performance Configuration
# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BINANCE=1200
RATE_LIMIT_BYBIT=600

# WebSocket Configuration
MAX_WEBSOCKET_CONNECTIONS=5
WEBSOCKET_RECONNECT_DELAY=3000

# Cache Configuration
CACHE_TTL_SETTINGS=300
CACHE_TTL_SUBSCRIPTION=600
CACHE_TTL_BALANCES=30
CACHE_MAX_SIZE_MB=50
