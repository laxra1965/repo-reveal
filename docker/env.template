# Environment Variables for Hetzner VPS Deployment
# Copy this file to .env and fill in your actual values
# Command: cp docker/env.template docker/.env

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Functions Configuration
FUNCTIONS_URL=https://api.yourdomain.com
# Or use IP: http://your-server-ip:8000
FUNCTIONS_API_KEY=generate-with-openssl-rand-hex-32

# CORS Configuration
# Comma-separated list of allowed origins (e.g., https://yourdomain.com,https://www.yourdomain.com)
# Use * for development only (not recommended for production)
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Server Configuration
PORT=8000

# Instructions:
# 1. Copy this file: cp docker/env.template docker/.env
# 2. Fill in all values above
# 3. Generate FUNCTIONS_API_KEY: openssl rand -hex 32
# 4. Get Supabase keys from: Dashboard > Settings > API
# 5. Set FUNCTIONS_URL to your VPS URL (with domain or IP:port)
# 6. Set ALLOWED_ORIGINS to your frontend domain(s)

