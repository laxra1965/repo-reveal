[Unit]
Description=API Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/repo-reveal/services/api
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=10
StandardOutput=append:/var/log/repo-reveal/api.log
StandardError=append:/var/log/repo-reveal/api.error.log
Environment=NODE_ENV=production
Environment=RUNTIME=vps

[Install]
WantedBy=multi-user.target
